# Copy to .env (NEVER commit .env). Generate strong random values for every secret.
DOMAIN=erp.example.com            # production domain (Caddy gets a TLS certificate automatically); "localhost" for a local trial
POSTGRES_USER=erp_owner           # DB owner: used ONLY by migrations/bootstrap
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=erp
APP_DB_USER=erp_app               # least-privilege role used by the web app (no superuser, no BYPASSRLS)
APP_DB_PASSWORD=CHANGE_ME_long_random_2
COOKIE_SECURE=true                # keep true behind HTTPS; false only for a plain-http local trial
